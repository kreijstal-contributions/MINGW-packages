# Maintainer: Mypal68 MSYS2 packagers

_realname=mypal68
pkgbase=mingw-w64-${_realname}
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=78.1.0
pkgrel=1
_rust_overlay="mypal68-rust-overlay-${pkgver}.tar.xz"
pkgdesc="Mypal 68 web browser for Windows XP and later (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64')
url="https://github.com/Feodor2/Mypal68"
license=('MPL-2.0')
depends=("${MINGW_PACKAGE_PREFIX}-cc-libs")
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-cbindgen"
  "${MINGW_PACKAGE_PREFIX}-clang"
  "${MINGW_PACKAGE_PREFIX}-fxc2"
  "${MINGW_PACKAGE_PREFIX}-llvm-tools"
  "${MINGW_PACKAGE_PREFIX}-nasm"
  "${MINGW_PACKAGE_PREFIX}-rust"
  "${MINGW_PACKAGE_PREFIX}-yasm"
  autoconf2.13
  diffutils
  git
  make
  "${MINGW_PACKAGE_PREFIX}-nodejs"
  patch
  perl
  python
  python-setuptools
  python-six
  rsync
  unzip
  zip
)
options=('!strip' '!debug' '!lto')
_patches=(
  '0001-Apply-mypal68-packaging-patches.patch'
  '0002-Use-gnullvm-rust-target-for-clang64.patch'
  '0003-Avoid-std-char-traits-for-Latin1Char.patch'
  '0004-Do-not-override-libcxx-throw-helpers.patch'
  '0005-Use-vector-for-RLZ-machine-id-bytes.patch'
  '0006-Include-fstream-before-hunspell-fopen-hook.patch'
  '0007-Use-byte-traits-for-mozpkix-ByteString.patch'
  '0008-Update-bindgen-to-0.69-in-Cargo.lock.patch'
  '0009-Update-socket2-and-libc-in-Cargo.lock.patch'
  '0010-Make-opaque-Servo-FFI-handles-interior-mutable.patch'
)
source=(
  "Mypal68-${pkgver}.tar.gz::https://github.com/Feodor2/Mypal68/archive/refs/tags/${pkgver}.tar.gz"
  "${_patches[@]}"
  'rust-vendor-prune.list'
  "${_rust_overlay}"
)
