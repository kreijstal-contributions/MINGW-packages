prepare() {
  cd "${srcdir}/Mypal68-${pkgver}"

  # The mingw64 ffvpx config starts as a copy of the MSVC one; 0001 adjusts
  # the few toolchain-dependent lines.
  cp media/ffvpx/config_win64.h media/ffvpx/config_mingw64.h
  # Let the per-platform configs override the disabled defaults.
  perl -pi -e 's/^#define (\w+) 0$/#ifndef $1\n#define $1 0\n#endif/' \
    media/ffvpx/defaults_disabled.h

  for patch in "${_patches[@]}"; do
    patch --binary -Np1 --forward -i "${srcdir}/${patch}"
  done

  while IFS= read -r path; do
    case "${path}" in
      ''|'#'*) continue ;;
      third_party/rust/*) rm -rf -- "${path}" ;;
      *)
        echo "Invalid Rust vendor prune path: ${path}" >&2
        return 1
        ;;
    esac
  done < "${srcdir}/rust-vendor-prune.list"

  bsdtar -xf "${srcdir}/${_rust_overlay}" -C .
  # quote 1.0.42, pulled in by bindgen 0.69, no longer exports __rt.
  sed -i 's/quote::__rt::TokenStream/TokenStream/' \
    third_party/rust/failure_derive/src/lib.rs

  # Mypal edits some vendored crates without refreshing their file hashes.
  # Recompute them; the package checksums that Cargo.lock pins are kept.
  find third_party/rust -name .cargo-checksum.json -print0 |
    xargs -0 perl -MJSON::PP -MDigest::SHA=sha256_hex -e '
      for my $path (@ARGV) {
        local $/;
        open my $in, "<", $path or die "$path: $!";
        my $json = decode_json(<$in>);
        close $in;
        (my $dir = $path) =~ s#/\.cargo-checksum\.json$##;
        for my $file (keys %{ $json->{files} }) {
          if (open my $f, "<:raw", "$dir/$file") {
            $json->{files}{$file} = sha256_hex(<$f>);
          } else {
            delete $json->{files}{$file};
          }
        }
        open my $out, ">", $path or die "$path: $!";
        print {$out} JSON::PP->new->canonical(1)->encode($json), "\n";
        close $out;
      }
    '
}

build() {
  cd "${srcdir}/Mypal68-${pkgver}"

  export CC="${MINGW_PREFIX}/bin/cc"
  export CXX="${MINGW_PREFIX}/bin/c++"
  export AR="${MINGW_PREFIX}/bin/ar"
  local _windres="${MINGW_PREFIX}/bin/windres"
  # bindgen needs clang even when GCC builds the C++ code, but configure
  # refuses --with-clang-path when the target compiler is clang already.
  local _clang_path="ac_add_options --with-clang-path=${MINGW_PREFIX}/bin/clang++"
  if [[ ${MINGW_PACKAGE_PREFIX} == mingw-w64-clang-* ]]; then
    _windres="${MINGW_PREFIX}/bin/llvm-windres"
    _clang_path=
  fi

  export RC="${_windres}"
  export RANLIB="${MINGW_PREFIX}/bin/ranlib"
  export WINDRES="${_windres}"
  export NODEJS="${MINGW_PREFIX}/bin/node"
  export RUSTC="${MINGW_PREFIX}/bin/rustc"
  export CARGO="${MINGW_PREFIX}/bin/cargo"
  export LLVM_OBJDUMP="${MINGW_PREFIX}/bin/llvm-objdump.exe"
  export PYTHON="/usr/bin/python3"
  export CARGO_NET_GIT_FETCH_WITH_CLI=true
  export PATH="/usr/bin:${MINGW_PREFIX}/bin:${PATH}"
  export MOZCONFIG="${srcdir}/mypal68-ucrt64.mozconfig"
  export D3DCOMPILER_DLL="/c/Windows/System32/d3dcompiler_47.dll"

  if [[ ! -f "${D3DCOMPILER_DLL}" ]]; then
    echo "Could not find d3dcompiler_47.dll at ${D3DCOMPILER_DLL}" >&2
    return 1
  fi
  install -Dm644 "${D3DCOMPILER_DLL}" "${MINGW_PREFIX}/bin/d3dcompiler_47.dll"

  cat > "${MOZCONFIG}" <<EOF
ac_add_options --with-libclang-path=${MINGW_PREFIX}/bin
${_clang_path}
ac_add_options --enable-nodejs
ac_add_options --disable-updater
ac_add_options --disable-tests
# 78.0.2 was built without these, and their Windows code (IA2/MSCOM, sctp,
# sipcc) has never been made to compile with mingw-w64 GCC.
ac_add_options --disable-accessibility
ac_add_options --disable-webrtc
# Mypal has no crash report server, and its tree never builds nsICrashReporter.
ac_add_options --disable-crashreporter
# mozjemalloc replaces free() in Mozilla code, but MSYS2 links the shared
# libstdc++-6.dll whose std::string allocations come from the CRT heap.
ac_add_options --disable-jemalloc
# Debug info makes xul.dll about 3.5 GB, which Windows refuses to load.
ac_add_options --disable-debug-symbols
EOF

  "${PYTHON}" ./mach configure
  "${PYTHON}" ./mach build
}

package() {
  cd "${srcdir}/Mypal68-${pkgver}"

  local objdir
  objdir="$(find . -maxdepth 1 -type d -name 'obj-*' -print -quit)"
  if [[ -z "${objdir}" || ! -d "${objdir}/dist/bin" ]]; then
    echo "Could not find built dist/bin directory" >&2
    return 1
  fi

  local appdir="${pkgdir}${MINGW_PREFIX}/lib/${_realname}"
  install -d "${appdir}" "${pkgdir}${MINGW_PREFIX}/bin"
  cp -a "${objdir}/dist/bin/." "${appdir}/"

  cat > "${pkgdir}${MINGW_PREFIX}/bin/${_realname}" <<EOF
#!/bin/sh
exec "\$(dirname "\$0")/../lib/${_realname}/mypal.exe" "\$@"
EOF
  chmod 755 "${pkgdir}${MINGW_PREFIX}/bin/${_realname}"

  cat > "${pkgdir}${MINGW_PREFIX}/bin/${_realname}.cmd" <<EOF
@echo off
setlocal
set "PATH=%~dp0;%PATH%"
"%~dp0..\lib\\${_realname}\mypal.exe" %*
EOF

  install -Dm644 LICENSE "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE"
}
