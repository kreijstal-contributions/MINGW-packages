prepare() {
  cd "${srcdir}/Mypal68-${pkgver}"

  for patch in "${srcdir}"/*.patch; do
    patch --binary -Np1 --forward --ignore-whitespace -i "${patch}"
  done

  # Some vendored Rust crates reference binary/test artifacts that are
  # intentionally not carried in this source package patch.
  find third_party/rust -name .cargo-checksum.json -print0 |
    xargs -0 perl -MJSON::PP -e '
      for my $path (@ARGV) {
        local $/;
        open my $in, "<", $path or die "$path: $!";
        my $text = <$in>;
        close $in;
        next unless length $text;
        my $dir = $path;
        $dir =~ s#/\.cargo-checksum\.json$##;
        my $json = decode_json($text);
        for my $file (keys %{ $json->{files} }) {
          delete $json->{files}{$file} unless -e "$dir/$file";
        }
        open my $out, ">", $path or die "$path: $!";
        print {$out} JSON::PP->new->canonical(1)->encode($json), "\n";
        close $out;
      }
    '

  if ! grep -q 'directory = "../@VENDORED_DIRECTORY@"' .cargo/config.in; then
    echo "Could not rewrite vendored Cargo source path" >&2
    return 1
  fi

  if ! grep -q "command' -v python3" mach; then
    echo "mach was not patched to use python3" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/Mypal68-${pkgver}"

  export CC=cc
  export CXX=c++
  export AR=ar
  local _windres="${MINGW_PREFIX}/bin/windres"
  if [[ ${MINGW_PACKAGE_PREFIX} == mingw-w64-clang-* ]]; then
    _windres="${MINGW_PREFIX}/bin/llvm-windres"
  fi

  export RC="${_windres}"
  export RANLIB=ranlib
  export WINDRES="${_windres}"
  export NODEJS="${MINGW_PREFIX}/bin/node"
  export CARGO_NET_GIT_FETCH_WITH_CLI=true
  export PATH="/usr/bin:${MINGW_PREFIX}/bin:${PATH}"
  export MOZCONFIG="${srcdir}/mypal68-ucrt64.mozconfig"
  export D3DCOMPILER_DLL="/c/Windows/System32/d3dcompiler_47.dll"

  if [[ ! -f "${D3DCOMPILER_DLL}" ]]; then
    echo "Could not find d3dcompiler_47.dll at ${D3DCOMPILER_DLL}" >&2
    return 1
  fi
  install -Dm644 "${D3DCOMPILER_DLL}" "${MINGW_PREFIX}/bin/d3dcompiler_47.dll"

  cat > "${MOZCONFIG}" <<EOF
ac_add_options --with-libclang-path=${MINGW_PREFIX}/bin
ac_add_options --enable-nodejs
EOF

  ./mach configure
  ./mach build
}

package() {
  cd "${srcdir}/Mypal68-${pkgver}"

  local objdir
  objdir="$(find . -maxdepth 1 -type d -name 'obj-*' -print -quit)"
  if [[ -z "${objdir}" || ! -d "${objdir}/dist/bin" ]]; then
    echo "Could not find built dist/bin directory" >&2
    return 1
  fi

  local appdir="${pkgdir}${MINGW_PREFIX}/lib/${_realname}"
  install -d "${appdir}" "${pkgdir}${MINGW_PREFIX}/bin"
  cp -a "${objdir}/dist/bin/." "${appdir}/"

  cat > "${pkgdir}${MINGW_PREFIX}/bin/${_realname}" <<EOF
#!/bin/sh
exec "\$(dirname "\$0")/../lib/${_realname}/mypal.exe" "\$@"
EOF
  chmod 755 "${pkgdir}${MINGW_PREFIX}/bin/${_realname}"

  cat > "${pkgdir}${MINGW_PREFIX}/bin/${_realname}.cmd" <<EOF
@echo off
"%~dp0..\lib\${_realname}\mypal.exe" %*
EOF

  install -Dm644 LICENSE "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE"
}
