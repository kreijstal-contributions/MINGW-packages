+        if isinstance(vstring, (list, tuple)):
+            vstring = ".".join(map(str, vstring))
+        
+        self.vstring = vstring
+        components = [x for x in self.component_re.split(vstring)
+                              if x and x != '.']
+        for i, obj in enumerate(components):
+            try:
