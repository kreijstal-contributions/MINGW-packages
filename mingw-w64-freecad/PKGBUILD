apply_patch_with_msg() {
  for _patch in "$@"
  do
    msg2 "Applying $_patch"
    patch -Nbp1 -i "${srcdir}/$_patch"
  done
}

prepare() {
  mv OndselSolver-*/* FreeCAD-${pkgver}/src/3rdParty/OndselSolver/

  cd FreeCAD-${pkgver}

  apply_patch_with_msg \
    001-clang19-char-traits.patch \
    002-fix-build-with-qt-6.10.patch
  # Fix Find Eigen3
  apply_patch_with_msg \
    fe951f63.patch \
     8547e798.patch
  # Fix install paths for MinGW - install Mod/Ext to lib/freecad
  apply_patch_with_msg \
    003-fix-install-paths.patch

  # Fix QOpenGLWidget crash on MinGW - disable hidden QOpenGLWidget creation
  # On MinGW, creating a hidden QOpenGLWidget at (-100,-100) causes Windows API
  # error ERROR_INVALID_PARAMETER (exit code 87) that terminates the application.
  sed -i '/auto _OpenGLWidget = new QOpenGLWidget/i #ifndef __MINGW32__' src/Gui/MainWindow.cpp
  sed -i '/_OpenGLWidget->move(QPoint(-100,-100));/a #else\n    \/\/ On MinGW, creating a hidden QOpenGLWidget causes Windows API errors\n    \/\/ (ERROR_INVALID_PARAMETER, exit code 87) that terminate the application.\n    \/\/ The OpenGL context will be created by Quarter widgets instead.\n#endif' src/Gui/MainWindow.cpp

  # Fix DESTINATION Mod paths without CMAKE_INSTALL_DATADIR
  # Single-line patterns
  find src -name "CMakeLists.txt" -exec sed -i 's|DESTINATION  *Mod/|DESTINATION ${CMAKE_INSTALL_DATADIR}/Mod/|g' {} \;
  find src -name "CMakeLists.txt" -exec sed -i 's|DESTINATION "Mod/|DESTINATION "${CMAKE_INSTALL_DATADIR}/Mod/|g' {} \;
  # Multi-line patterns (DESTINATION on one line, Mod/ on next line)
  find src -name "CMakeLists.txt" -exec sed -i '/^[[:space:]]*DESTINATION$/{N;s|\(DESTINATION\n[[:space:]]*\)Mod/|\1${CMAKE_INSTALL_DATADIR}/Mod/|g}' {} \;
  # Fix Ext/freecad/gui in Gui/CMakeLists.txt (multi-line: DESTINATION on one line, path on next)
  sed -i '/^[[:space:]]*DESTINATION$/{N;s|\(DESTINATION\n[[:space:]]*\)Ext/freecad/gui|\1${CMAKE_INSTALL_DATADIR}/Ext/freecad/gui|g}' src/Gui/CMakeLists.txt
  # Also fix the fc_copy_sources call
  sed -i 's|${CMAKE_BINARY_DIR}/Ext/freecad/gui|${CMAKE_BINARY_DIR}/${CMAKE_INSTALL_DATADIR}/Ext/freecad/gui|g' src/Gui/CMakeLists.txt

  # Fix hardcoded AppHomePath in WizardShaft.py - use getResourceDir() instead
  sed -i 's|FreeCAD.ConfigGet("AppHomePath") + "Mod/|FreeCAD.getResourceDir() + "Mod/|g' src/Mod/PartDesign/WizardShaft/WizardShaft.py

  # opencascade defines HAVE_TBB which makes FreeCAD uses TBB without linking to it.
  sed -i "s|HAVE_TBB|HAVE_NOT_TBB|g" src/Mod/Import/App/ImportOCAF.cpp
}

build() {
  declare -a _extra_config
  if check_option "debug" "n"; then
    _extra_config+=("-DCMAKE_BUILD_TYPE=Release")
  else
    _extra_config+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  if [[ ${CC} == clang ]]; then
    CXXFLAGS+=" -Wno-macro-redefined"
  else
    CXXFLAGS+=" -Wno-template-id-cdtor"
  fi

  CXXFLAGS+=" -Wno-deprecated-declarations -Wno-unknown-pragmas" \
  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=;" \
    cmake -Wno-dev \
      -GNinja \
      -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}" \
      -DFREECAD_QT_VERSION="6" \
      -DBUILD_TEST=OFF \
      -DBUILD_WEB=OFF \
      -DBUILD_ADDONMGR=OFF \
      -DENABLE_DEVELOPER_TESTS=OFF \
      -DINSTALL_TO_SITEPACKAGES=OFF \
      -DPython_EXECUTABLE=${MINGW_PREFIX}/bin/python \
      -DPython3_EXECUTABLE=${MINGW_PREFIX}/bin/python \
      "${_extra_config[@]}" \
      -S "FreeCAD-${pkgver}" \
      -B "build-${MSYSTEM}"

  cmake --build "build-${MSYSTEM}"
}

package() {
  DESTDIR="${pkgdir}" "${MINGW_PREFIX}"/bin/cmake.exe --install "build-${MSYSTEM}"

  install -Dm644 FreeCAD-${pkgver}/LICENSE \
    "${pkgdir}"${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE

  MSYS2_ARG_CONV_EXCL="-d" \
    python -m compileall -o 0 -o 1 -q -d"${MINGW_PREFIX}" "${pkgdir}${MINGW_PREFIX}"
}
