# Contributor: Kreijstal <elektrischrainbow@gmail.com>

_realname=lean4
pkgbase=mingw-w64-${_realname}
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=4.33.0
pkgrel=1
pkgdesc="Functional programming language and theorem prover (mingw-w64)"
arch=('any')
mingw_arch=('ucrt64' 'clang64')
url="https://lean-lang.org"
msys2_repository_url="https://github.com/leanprover/lean4"
license=('spdx:Apache-2.0')
if [[ ${MSYSTEM} == CLANG64 ]]; then
  LEAN_CXX_STDLIB='-lc++ -lc++abi'
  depends=("${MINGW_PACKAGE_PREFIX}-clang"
           "${MINGW_PACKAGE_PREFIX}-gmp"
           "${MINGW_PACKAGE_PREFIX}-libc++"
           "${MINGW_PACKAGE_PREFIX}-libuv"
           "${MINGW_PACKAGE_PREFIX}-openssl")
  makedepends=("${MINGW_PACKAGE_PREFIX}-cmake"
               "${MINGW_PACKAGE_PREFIX}-ccache"
               'binutils'
               'diffutils'
               'git'
               'make'
               'python')
else
  LEAN_CXX_STDLIB='-lstdc++'
  # leanc invokes the C++ compiler when building Lean executables, so GCC is a
  # runtime dependency rather than only a build dependency.
  depends=("${MINGW_PACKAGE_PREFIX}-gcc"
           "${MINGW_PACKAGE_PREFIX}-gmp"
           "${MINGW_PACKAGE_PREFIX}-libuv"
           "${MINGW_PACKAGE_PREFIX}-openssl")
  makedepends=("${MINGW_PACKAGE_PREFIX}-cmake"
               "${MINGW_PACKAGE_PREFIX}-ccache"
               'binutils'
               'diffutils'
               'git'
               'make'
               'python')
fi
optdepends=('git: fetch Lake package dependencies')
options=('!lto')
_cadical_ver=2.1.2
_leantar_ver=0.1.20
source=("${_realname}-${pkgver}.tar.gz::https://github.com/leanprover/lean4/archive/refs/tags/v${pkgver}.tar.gz"
        "cadical-${_cadical_ver}.tar.gz::https://github.com/arminbiere/cadical/archive/refs/tags/rel-${_cadical_ver}.tar.gz"
        "https://github.com/digama0/leangz/releases/download/v${_leantar_ver}/leantar-v${_leantar_ver}-x86_64-pc-windows-msvc.zip"
        '0001-export-free_sized-declaration.patch')
sha256sums=('348d0839049a7cbb72b5e82196670e4ded6e1f8ec4610cd6c5188b2754a1f24c'
            '292c2bb8d712d6d05fce3d3df63b922b8fa45e03974a79f7bae5bf68c284f131'
            '7bb21a0a8d152da25863ad53039edddf5fd656b9d7be298b221f4565027f8cc7'
            '0274546d2b726b50b64e989ca56eea8bf848253c0daa19e099d2dd0b16a71329')
noextract=("${_realname}-${pkgver}.tar.gz")

prepare() {
  local _lean_src="${srcdir}/${_realname}-${pkgver}"

  # GitHub's archive contains symlinks, which cannot be created on the hosted
  # Windows runners. Extract everything else and materialise the links as files.
  rm -rf "${_lean_src}"
  bsdtar -xf "${srcdir}/${_realname}-${pkgver}.tar.gz" -C "${srcdir}" \
    --exclude="${_realname}-${pkgver}/AGENTS.md" \
    --exclude="${_realname}-${pkgver}/tests/bench/build/fake_root/bin/lean" \
    --exclude="${_realname}-${pkgver}/tests/compile_bench/rbmap_checkpoint2.lean" \
    --exclude="${_realname}-${pkgver}/tests/compile_bench/run_test.sh" \
    --exclude="${_realname}-${pkgver}/tests/elab_bench/big_omega_MT.lean" \
    --exclude="${_realname}-${pkgver}/tests/elab_bench/iterators.lean" \
    --exclude="${_realname}-${pkgver}/tests/elab_bench/run_test.sh"

  patch -d "${_lean_src}" -Np1 \
    -i "${srcdir}/0001-export-free_sized-declaration.patch"

  cp -a "${_lean_src}/.claude/CLAUDE.md" "${_lean_src}/AGENTS.md"
  cp -a "${_lean_src}/tests/bench/build/lean_wrapper.py" \
    "${_lean_src}/tests/bench/build/fake_root/bin/lean"
  cp -a "${_lean_src}/tests/compile_bench/rbmap_checkpoint.lean" \
    "${_lean_src}/tests/compile_bench/rbmap_checkpoint2.lean"
  cp -a "${_lean_src}/tests/compile/run_test.sh" \
    "${_lean_src}/tests/compile_bench/run_test.sh"
  cp -a "${_lean_src}/tests/elab_bench/big_omega.lean" \
    "${_lean_src}/tests/elab_bench/big_omega_MT.lean"
  cp -a "${_lean_src}/tests/compile_bench/iterators.lean" \
    "${_lean_src}/tests/elab_bench/iterators.lean"
  cp -a "${_lean_src}/tests/elab/run_test.sh" \
    "${_lean_src}/tests/elab_bench/run_test.sh"

  rm -rf "${srcdir}/cadical-work"
  install -d "${srcdir}/cadical-work/src"
  cp -a "${srcdir}/cadical-rel-${_cadical_ver}" \
    "${srcdir}/cadical-work/src/cadical"
}

build() {
  local _lean_src="${srcdir}/${_realname}-${pkgver}"
  local _cadical_src="${srcdir}/cadical-work/src/cadical"
  local _cadical="${srcdir}/cadical-work/cadical.exe"
  local _leantar="${srcdir}/leantar-v${_leantar_ver}-x86_64-pc-windows-msvc/leantar.exe"
  local _build_dir="${srcdir}/build-${MSYSTEM}"

  make -C "${_cadical_src}" \
    -f "${_lean_src}/src/cadical.mk" \
    CMAKE_EXECUTABLE_SUFFIX='.exe' \
    CXX="${CXX}" \
    CXXFLAGS="${CXXFLAGS} -DNUNLOCKED -DNCLOSEFROM" \
    LDFLAGS="${LDFLAGS}"

  rm -rf "${_build_dir}"
  # The bootstrap does not forward the top-level install prefix automatically.
  # Keep the explicit stage1 prefix unconverted so DESTDIR can prepend it.
  export MSYS2_ARG_CONV_EXCL='-DCMAKE_INSTALL_PREFIX='
  cmake \
    -G 'Unix Makefiles' \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}" \
    -DCMAKE_C_COMPILER="${CC}" \
    -DCMAKE_CXX_COMPILER="${CXX}" \
    -DCADICAL="${_cadical}" \
    -DLEANTAR="${_leantar}" \
    -DINSTALL_LICENSE=OFF \
    -DLEAN_CXX_STDLIB="${LEAN_CXX_STDLIB}" \
    -DSTAGE1_CMAKE_INSTALL_PREFIX="${MINGW_PREFIX}" \
    -DSTRIP_BINARIES=OFF \
    -DUSE_GITHASH=OFF \
    -DUSE_MIMALLOC=OFF \
    -S "${_lean_src}" \
    -B "${_build_dir}"

  cmake --build "${_build_dir}" --parallel "${NUMBER_OF_PROCESSORS:-2}"
}

check() {
  local _lean="${srcdir}/build-${MSYSTEM}/stage1/bin/lean.exe"
  local _lake="${srcdir}/build-${MSYSTEM}/stage1/bin/lake.exe"

  "${_lean}" --version
  "${_lake}" --version
  printf '#eval 1 + 1\n' > "${srcdir}/lean-smoke-test.lean"
  "${_lean}" "${srcdir}/lean-smoke-test.lean"
}

package() {
  local _lean_src="${srcdir}/${_realname}-${pkgver}"

  # Install stage1 directly with a native staging prefix. The top-level install
  # delegates through a relative stage1 path and cannot override this prefix.
  cmake --install "$(cygpath -m "${srcdir}/build-${MSYSTEM}/stage1")" \
    --prefix "$(cygpath -m "${pkgdir}${MINGW_PREFIX}")"

  local _binary
  for _binary in lean lake leanc leanchecker leanir cadical leantar; do
    if [[ ! -x "${pkgdir}${MINGW_PREFIX}/bin/${_binary}.exe" ]]; then
      echo "Missing installed ${_binary}.exe" >&2
      return 1
    fi
  done

  local _directory
  for _directory in include lib/lean share/lean src/lean; do
    if [[ ! -d "${pkgdir}${MINGW_PREFIX}/${_directory}" ]]; then
      echo "Missing installed ${_directory} directory" >&2
      return 1
    fi
  done

  local _file
  for _file in include/lean/lean.h lib/lean/Init.olean share/lean/lean.mk; do
    if [[ ! -f "${pkgdir}${MINGW_PREFIX}/${_file}" ]]; then
      echo "Missing installed ${_file}" >&2
      return 1
    fi
  done

  PATH="${pkgdir}${MINGW_PREFIX}/bin:${PATH}" \
    "${pkgdir}${MINGW_PREFIX}/bin/lean.exe" --version
  PATH="${pkgdir}${MINGW_PREFIX}/bin:${PATH}" \
    "${pkgdir}${MINGW_PREFIX}/bin/lake.exe" --version
  printf '#eval 1 + 1\n' > "${srcdir}/lean-installed-smoke-test.lean"
  PATH="${pkgdir}${MINGW_PREFIX}/bin:${PATH}" \
    "${pkgdir}${MINGW_PREFIX}/bin/lean.exe" \
    "${srcdir}/lean-installed-smoke-test.lean"

  install -Dm644 "${_lean_src}/LICENSE" \
    "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE"
  install -Dm644 "${_lean_src}/LICENSES" \
    "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSES"
}
